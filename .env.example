# Optional BFF host port. UI and Keycloak keep their registered browser addresses.
API_PORT=8080
# Local demo credential; use a strong secret and HTTPS outside this learning setup.
KEYCLOAK_CLIENT_SECRET=local-bff-secret
DATABASE_PASSWORD=local-employees-password
# Cosine similarity (not a probability). Calibrate with your own enrollment/query photos.
FACE_SIMILARITY_THRESHOLD=0.5
FACE_AMBIGUITY_MARGIN=0.05
